# Zugangsdaten. Muss ganz oben stehen und darf nie entfernt werden: das
# Repository wird öffentlich auf GitHub veröffentlicht.
data/zefix_zugang.json
data/github_zugang.json
*_zugang.json
.env
*.pem
*.key

# Persönliche Korrespondenz. Enthält Mailadressen und gehört nicht in ein
# öffentliches Repository, auch wenn keine Passwörter darin stehen.
mail-*.md
SKILL-*.md

# Interne Arbeitsauftraege. Sie beschreiben, was bei einer Veroeffentlichung
# schiefgehen kann, und fuehren dafuer die Suchmuster mit, nach denen geprueft
# wird: Mailadresse, Strassenname, Tokenanfaenge. Genau diese Zeichenfolgen
# gehoeren nicht in ein oeffentliches Repository, auch wenn sie dort nur als
# Suchmuster stehen.
docs/AUFTRAG_*.md

# Rohergebnisse der Personensuche im Handelsregister. Sie stammen aus einer
# Suche über den Nachnamen und enthalten darum auch Namensvettern. Sie einem
# öffentlichen Repository beizulegen hiesse, ungeprüfte Verbindungen zwischen
# namentlich genannten Politikern und Firmen zu behaupten. Ins Dashboard darf
# nur, was am Registerauszug bestätigt ist.
data/hr_personen.json
data/hr_abfrage_status.json
data/interessen_register_pruefliste.md
data/interessen_register_voll.json

# Von Hand nachgetragene Wohngemeinden. Sie dienen allein der Zuordnung von
# Registerfunden und haben in einer öffentlichen Ausgabe nichts zu suchen.
data/mitglieder_ergaenzung.json

# Stammdaten der Ratsmitglieder. Sie stehen zwar so auf sh.ch, enthalten aber
# Wohnadresse, Geburtsdatum und Mailadresse von 59 Personen. Das Dashboard
# braucht davon nur die Gemeinde, und ein öffentliches Repository braucht die
# Datei gar nicht: scripts/mitglieder.py stellt sie jederzeit wieder her.
data/mitglieder.json

# Python
__pycache__/
*.pyc

# Vom Scraper regenerierte Rohdaten (nicht versionieren)
data/raw/
data/protokolle/

# Archiv und Zwischenstände
archiv/

# Bauergebnis. Es steckt identisch in site/index.html, das veröffentlicht wird.
# Beides zu versionieren verdoppelt jede Fassung in der Historie.
output/

# Abstimmungsspiegel: je Vorlage bleibt draussen, was gross ist und nicht in die
# Seite eingeht. Drin bleibt die ganze Datenkette von roh bis freigegeben
# (zusammen gut 1 MB), die Skripte, die Dokumentation und die SVGs: bei einem
# Transparenzprojekt gehoert die Herleitung offengelegt, nicht nur das Ergebnis.
#   00_uebergabe_michael/berichte, grafiken, karten_gemeinden
#                          Originalstand der Uebergabe als PDF und PNG (28 MB);
#                          die Skripte und Notizen daneben bleiben drin
#   grafiken/**/*.png      Druckfassungen; die Seite bindet nur SVG ein
abstimmungsspiegel/abstimmungen/*/geo/00_uebergabe_michael/berichte/
abstimmungsspiegel/abstimmungen/*/geo/00_uebergabe_michael/grafiken/
abstimmungsspiegel/abstimmungen/*/geo/00_uebergabe_michael/karten_gemeinden/
abstimmungsspiegel/abstimmungen/*/grafiken/**/*.png
abstimmungsspiegel/abstimmungen/*/grafiken/*.png
# 21 MB Fassadenpunkte des Laermkatasters; haushalte.py holt sie in Sekunden neu.
abstimmungsspiegel/abstimmungen/*/geo/01_roh/laerm_fassadenpunkte_tag_roh.xml

# Sonden und Reste eines Baulaufs in der Ausgabe.
site/abstimmung/*/grafiken/_probe
